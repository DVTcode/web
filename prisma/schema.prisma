generator client {
  provider      = "prisma-client-js"
  output        = "../app/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL_2")
  relationMode = "prisma"
}

model User {
  id                     String                @id @default(cuid())
  name                   String?
  email                  String                @unique
  emailVerified          DateTime?
  image                  String?
  passwordHash           String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  globalRole             SystemRole            @default(STANDARD)
  lastLoginAt            DateTime?
  lastLoginIp            String?
  status                 UserStatus            @default(ACTIVE)
  suspendedAt            DateTime?
  suspendedById          String?
  suspendedReason        String?
  bio                    String?
  links                  Json?
  phone                  String?
  timezone               String?               @default("Asia/Ho_Chi_Minh")
  title                  String?
  accounts               Account[]
  activities             ActivityLog[]
  auditLogs              AuditLog[]
  backupsFinished        BackupSnapshot[]      @relation("BackupFinishedBy")
  backupsStarted         BackupSnapshot[]      @relation("BackupStartedBy")
  dailyReports           DailyReport[]
  integrationsCreated    Integration[]         @relation("IntegrationCreatedBy")
  integrationsUpdated    Integration[]         @relation("IntegrationUpdatedBy")
  milestonesOwned        Milestone[]
  notifications          Notification[]
  notificationSettings   NotificationSetting[]
  organizations          OrganizationMember[]
  projectsCreated        Project[]             @relation("ProjectCreator")
  projectsLed            Project[]             @relation("ProjectLead")
  projectActivities      ProjectActivity[]     @relation("UserProjectActivities")
  projectComments        ProjectComment[]
  projectInvitesSent     ProjectInvite[]       @relation("InvitedByUser")
  projectInvitesReceived ProjectInvite[]       @relation("RecipientUser")
  organizationInvitesSent     OrganizationInvite[]       @relation("OrgInvitedByUser")
  organizationInvitesReceived OrganizationInvite[]       @relation("OrgRecipientUser")
  projectMemberships     ProjectMember[]
  resources              Resource[]
  sessions               Session[]
  sprintsCreated         Sprint[]              @relation("SprintCreatedBy")
  SystemSetting          SystemSetting[]
  tasksCreated           Task[]                @relation("TaskCreatedBy")
  followedTasks          Task[]                @relation("TaskFollower")
  tasksUpdated           Task[]                @relation("TaskUpdatedBy")
  taskActivities         TaskActivity[]        @relation("UserTaskActivities")
  taskAssignments        TaskAssignee[]
  attachmentsAdded       TaskAttachment[]
  comments               TaskComment[]
  timeEntries            TimeEntry[]
  suspendedBy            User?                 @relation("UserSuspendedBy", fields: [suspendedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  suspendedUsers         User[]                @relation("UserSuspendedBy")

  @@index([globalRole])
  @@index([status])
  @@index([suspendedById], map: "User_suspendedById_fkey")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId], map: "Session_userId_fkey")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}

model Organization {
  id        String               @id @default(cuid())
  name      String
  slug      String               @unique
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   OrganizationMember[]
  invites   OrganizationInvite[]
  projects  Project[]

  @@index([slug])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole      @default(MEMBER)
  joinedAt       DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Project {
  id                  String                @id @default(cuid())
  organizationId      String
  key                 String                @unique
  name                String
  description         String?               @db.Text
  status              String                @default("active")
  startDate           DateTime?
  dueDate             DateTime?
  leadId              String?
  createdById         String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  activities          ActivityLog[]
  columns             BoardColumn[]
  events              CalendarEvent[]
  DailyReport         DailyReport[]
  milestones          Milestone[]
  notifications       Notification[]
  NotificationSetting NotificationSetting[]
  createdBy           User                  @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: Cascade)
  lead                User?                 @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  projectActivities   ProjectActivity[]
  projectComments     ProjectComment[]
  invites             ProjectInvite[]
  members             ProjectMember[]
  resources           Resource[]
  sprints             Sprint[]
  Tag                 Tag[]
  tasks               Task[]

  @@index([organizationId])
  @@index([createdById], map: "Project_createdById_fkey")
  @@index([leadId], map: "Project_leadId_fkey")
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model BoardColumn {
  id        String  @id @default(cuid())
  projectId String
  name      String
  order     Int     @default(0)
  isDefault Boolean @default(false)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tasks     Task[]

  @@unique([projectId, name])
  @@index([projectId, order])
}

model Task {
  id               String           @id @default(cuid())
  projectId        String
  columnId         String?
  sprintId         String?
  title            String
  description      String?          @db.Text
  status           TaskStatus       @default(TODO)
  priority         Priority         @default(MEDIUM)
  points           Int?
  estimateHours    Decimal?         @db.Decimal(6, 2)
  startDate        DateTime?
  dueDate          DateTime?
  order            Int?
  createdById      String
  updatedById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  followerId       String?
  activities       ActivityLog[]
  events           CalendarEvent[]
  Notification     Notification[]
  column           BoardColumn?     @relation(fields: [columnId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy        User             @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: Cascade)
  follower         User?            @relation("TaskFollower", fields: [followerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sprint           Sprint?          @relation(fields: [sprintId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updatedBy        User?            @relation("TaskUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  taskActivities   TaskActivity[]
  assignees        TaskAssignee[]
  attachments      TaskAttachment[]
  comments         TaskComment[]
  dependenciesFrom TaskDependency[] @relation("FromTask")
  dependenciesTo   TaskDependency[] @relation("ToTask")
  tags             TaskTag[]
  milestoneId      String?
  milestone        Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  timeEntries      TimeEntry[]

  @@index([projectId, status, priority])
  @@index([columnId, order])
  @@index([sprintId])
  @@index([milestoneId])
  @@index([createdById], map: "Task_createdById_fkey")
  @@index([updatedById], map: "Task_updatedById_fkey")
  @@index([followerId])
}

model TaskAssignee {
  id         String   @id @default(cuid())
  taskId     String
  userId     String
  assignedAt DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

model Tag {
  id        String    @id @default(cuid())
  projectId String
  name      String
  slug      String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tasks     TaskTag[]

  @@unique([projectId, slug])
  @@index([projectId])
}

model TaskTag {
  taskId String
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([taskId, tagId])
  @@index([tagId], map: "TaskTag_tagId_fkey")
}

model TaskComment {
  id          String           @id @default(cuid())
  taskId      String
  authorId    String
  content     String
  parentId    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  attachments TaskAttachment[]
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parent      TaskComment?     @relation("CommentThread", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies     TaskComment[]    @relation("CommentThread")
  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([authorId], map: "TaskComment_authorId_fkey")
  @@index([parentId], map: "TaskComment_parentId_fkey")
  @@index([taskId], map: "TaskComment_taskId_fkey")
}

model ProjectComment {
  id        String           @id @default(cuid())
  projectId String
  authorId  String
  content   String
  parentId  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  mentions  CommentMention[]
  attachments Json?
  author    User             @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  parent    ProjectComment?  @relation("ProjectCommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   ProjectComment[] @relation("ProjectCommentReplies")
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([projectId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId], map: "ProjectComment_parentId_fkey")
}

model CommentMention {
  id               String          @id @default(cuid())
  userId           String
  createdAt        DateTime        @default(now())
  taskCommentId    String?
  projectCommentId String?
  projectComment   ProjectComment? @relation(fields: [projectCommentId], references: [id], onDelete: NoAction, onUpdate: Cascade)

  @@unique([projectCommentId, userId])
  @@unique([taskCommentId, userId])
  @@index([userId])
  @@index([projectCommentId])
  @@index([taskCommentId])
}

model TaskAttachment {
  id            String       @id @default(cuid())
  taskId        String
  resourceId    String
  addedById     String
  addedAt       DateTime     @default(now())
  taskCommentId String?
  addedBy       User         @relation(fields: [addedById], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resource      Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  TaskComment   TaskComment? @relation(fields: [taskCommentId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  task          Task         @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([taskId])
  @@index([addedById], map: "TaskAttachment_addedById_fkey")
  @@index([resourceId], map: "TaskAttachment_resourceId_fkey")
  @@index([taskCommentId], map: "TaskAttachment_taskCommentId_fkey")
}

model TaskDependency {
  id         String         @id @default(cuid())
  fromTaskId String
  toTaskId   String
  type       DependencyType @default(BLOCKS)
  from       Task           @relation("FromTask", fields: [fromTaskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  to         Task           @relation("ToTask", fields: [toTaskId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([fromTaskId, toTaskId])
  @@index([toTaskId])
}

model Sprint {
  id          String       @id @default(cuid())
  projectId   String
  name        String
  goal        String?
  startDate   DateTime
  endDate     DateTime
  status      SprintStatus @default(PLANNED)
  createdAt   DateTime     @default(now())
  createdById String?
  updatedAt   DateTime     @updatedAt
  createdBy   User?        @relation("SprintCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  milestoneId String?
  milestone   Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  tasks       Task[]

  @@index([projectId, startDate, endDate])
  @@index([projectId, status])
  @@index([createdById], map: "Sprint_createdById_fkey")
  @@index([milestoneId])
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  description String?     @db.Text
  dueDate     DateTime
  status      String          @default("open")
  ownerId     String?
  progress    Int?
  title       String
  events      CalendarEvent[]
  owner       User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  startDate   DateTime? // Optional start date if needed
  sprints     Sprint[]
  tasks       Task[] // Tasks directly linked to milestone

  @@index([projectId, dueDate])
  @@index([ownerId], map: "Milestone_ownerId_fkey")
}

model CalendarEvent {
  id          String     @id @default(cuid())
  projectId   String
  taskId      String?
  milestoneId String?
  provider    String?
  externalId  String?
  summary     String
  description String?
  start       DateTime
  end         DateTime
  createdAt   DateTime   @default(now())
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  task        Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([projectId, start, end])
  @@index([milestoneId], map: "CalendarEvent_milestoneId_fkey")
  @@index([taskId], map: "CalendarEvent_taskId_fkey")
}

model Resource {
  id          String           @id @default(cuid())
  projectId   String
  type        ResourceType
  name        String
  url         String?
  bucket      String?
  objectKey   String?
  mimeType    String?
  size        Int?
  createdById String
  createdAt   DateTime         @default(now())
  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Cascade, onUpdate: Cascade)
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  attachments TaskAttachment[]

  @@index([projectId, type])
  @@index([createdById], map: "Resource_createdById_fkey")
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  type        NotificationType
  projectId   String?
  taskId      String?
  data        Json?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  task        Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([recipientId, readAt])
  @@index([projectId], map: "Notification_projectId_fkey")
  @@index([taskId], map: "Notification_taskId_fkey")
}

model NotificationSetting {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  email       Boolean  @default(true)
  push        Boolean  @default(true)
  silentStart Int?
  silentEnd   Int?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, projectId])
  @@index([projectId], map: "NotificationSetting_projectId_fkey")
}

model TimeEntry {
  id        String    @id @default(cuid())
  taskId    String
  userId    String
  startedAt DateTime
  endedAt   DateTime?
  minutes   Int?
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([taskId, userId, startedAt])
  @@index([userId], map: "TimeEntry_userId_fkey")
}

model DailyReport {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  date      DateTime
  done      String?
  doing     String?
  blockers  String?
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([projectId, authorId, date])
  @@index([projectId, date])
  @@index([authorId], map: "DailyReport_authorId_fkey")
}

model ActivityLog {
  id        String       @id @default(cuid())
  projectId String?
  taskId    String?
  actorId   String
  type      ActivityType
  message   String?
  meta      Json?
  createdAt DateTime     @default(now())
  actor     User         @relation(fields: [actorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  task      Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([actorId], map: "ActivityLog_actorId_fkey")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json?
  isSecret    Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @default(now())
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([updatedById], map: "SystemSetting_updatedById_fkey")
}

model Integration {
  id          String              @id @default(cuid())
  provider    IntegrationProvider
  name        String
  enabled     Boolean             @default(true)
  config      Json
  createdById String?
  updatedById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdBy   User?               @relation("IntegrationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updatedBy   User?               @relation("IntegrationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([provider, enabled])
  @@index([createdById], map: "Integration_createdById_fkey")
  @@index([updatedById], map: "Integration_updatedById_fkey")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String?
  entityId   String?
  ip         String?
  userAgent  String?
  details    Json?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId], map: "AuditLog_actorId_fkey")
}

model BackupSnapshot {
  id           String          @id @default(cuid())
  status       BackupStatus    @default(PENDING)
  storage      StorageProvider @default(MINIO)
  location     String
  sizeBytes    BigInt?
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?
  startedById  String?
  finishedById String?
  notes        String?
  finishedBy   User?           @relation("BackupFinishedBy", fields: [finishedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  startedBy    User?           @relation("BackupStartedBy", fields: [startedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, startedAt])
  @@index([finishedById], map: "BackupSnapshot_finishedById_fkey")
  @@index([startedById], map: "BackupSnapshot_startedById_fkey")
}

model ProjectInvite {
  id          String       @id @default(cuid())
  projectId   String
  recipientId String
  role        ProjectRole  @default(MEMBER)
  token       String       @unique
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime?
  invitedById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  invitedBy   User?        @relation("InvitedByUser", fields: [invitedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recipient   User         @relation("RecipientUser", fields: [recipientId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([projectId, status])
  @@index([recipientId, status])
  @@index([invitedById], map: "ProjectInvite_invitedById_fkey")
}

model OrganizationInvite {
  id          String       @id @default(cuid())
  organizationId String
  recipientId String
  role        OrgRole      @default(MEMBER)
  token       String       @unique
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime?
  invitedById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  invitedBy   User?        @relation("OrgInvitedByUser", fields: [invitedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recipient   User         @relation("OrgRecipientUser", fields: [recipientId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId, status])
  @@index([recipientId, status])
  @@index([invitedById], map: "OrganizationInvite_invitedById_fkey")
}

model HelpArticle {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  contentMd   String   @db.Text
  category    String?
  tags        String?
  orgId       String?
  projectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isPublished Boolean  @default(true)
}

model ChatSession {
  id        String         @id @default(cuid())
  userId    String?
  orgId     String?
  projectId String?
  title     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  feedbacks ChatFeedback[]
  messages  ChatMessage[]
}

model ChatMessage {
  id             String      @id @default(cuid())
  sessionId      String
  role           String
  content        String      @db.Text
  toolName       String?
  toolArgsJson   String?
  toolResultJson String?
  orgId          String?
  projectId      String?
  createdAt      DateTime    @default(now())
  session        ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([sessionId], map: "ChatMessage_sessionId_fkey")
}

model ChatFeedback {
  id        String      @id @default(cuid())
  sessionId String
  messageId String?
  rating    Int
  comment   String?
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([sessionId], map: "ChatFeedback_sessionId_fkey")
}

model ProjectActivity {
  id        String       @id @default(cuid())
  projectId String
  type      ActivityType
  message   String?      @db.Text
  meta      Json?
  actorId   String?
  createdAt DateTime     @default(now())
  actor     User?        @relation("UserProjectActivities", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([actorId], map: "ProjectActivity_actorId_fkey")
}

model TaskActivity {
  id        String       @id @default(cuid())
  taskId    String
  type      ActivityType
  message   String?      @db.Text
  meta      Json?
  actorId   String?
  createdAt DateTime     @default(now())
  actor     User?        @relation("UserTaskActivities", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([taskId, createdAt(sort: Desc)])
  @@index([actorId], map: "TaskActivity_actorId_fkey")
}

